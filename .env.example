# Copy to .env and adjust as needed. All have sensible defaults if unset.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3
AVAILABLE_MODELS=llama3,mistral,gemma,qwen,deepseek-r1

# --- Embeddings / Reranking ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_ENABLED=true
RERANK_CANDIDATES=20
RERANK_TOP_N=5

# --- Retrieval ---
RETRIEVAL_K=10
USE_MMR=true
HYBRID_SEARCH_ENABLED=true
RRF_K=60

# --- Chunking ---
CHUNK_SIZE=900
CHUNK_OVERLAP=175

# --- OCR ---
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=20

# --- Chat memory ---
MAX_HISTORY_TURNS=6
